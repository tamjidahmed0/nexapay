<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NexaPay — Reset Password</title>
    <style>
        body {
            background-color: #F0F2F8;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            padding: 40px 16px;
        }

        .wrapper {
            max-width: 520px;
            margin: 0 auto;
        }

        .card {
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .title {
            font-size: 22px;
            font-weight: 800;
            color: #1A1F5E;
            margin-bottom: 12px;
        }

        .text {
            font-size: 14px;
            color: #6B7280;
            margin-bottom: 28px;
            line-height: 1.6;
        }

        .otp-box {
            background: #F4F6FA;
            border: 1.5px solid #E2E5F1;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            margin-bottom: 16px;
        }

        .otp {
            font-size: 36px;
            font-weight: 800;
            color: #1A1F5E;
            letter-spacing: 8px;
        }

        .expiry {
            font-size: 13px;
            color: #6B7280;
            margin-bottom: 24px;
        }

        .warning {
            background: #FFF3F3;
            border: 1px solid #FECACA;
            padding: 12px;
            border-radius: 10px;
            font-size: 13px;
            color: #991B1B;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #9CA3AF;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="wrapper">
        <div class="card">

            <h2 class="title">Reset your password</h2>

            <p class="text">
                Hi {{name}},<br /><br />
                Use the verification code below to reset your NexaPay password.
            </p>

            <div class="otp-box">
                <div class="otp">{{otp}}</div>
            </div>

            <p class="expiry">
                This code will expire in <strong>{{expiryMinutes}} minutes</strong>.
            </p>

            <div class="warning">
                Never share this code with anyone. NexaPay will never ask for your OTP.
            </div>

        </div>

        <div class="footer">
            If you didn’t request this, you can safely ignore this email.<br />
            NexaPay • Secure. Fast. Simple.
        </div>
    </div>

</body>

</html>